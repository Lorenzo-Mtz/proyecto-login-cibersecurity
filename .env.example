# Copia este archivo a .env (que ya esta en .gitignore) y cambia el valor.
# SECRET_KEY se usa para firmar la cookie de sesion y los mensajes flash.
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
# Es obligatorio: la app no arranca si falta, si deja este valor de ejemplo
# o si tiene menos de 32 caracteres.
SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo
